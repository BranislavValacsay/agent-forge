VERSION = "0.6.0"
DEFAULT_CONFIG = Path.home() / ".config" / "agent-forge-worker" / "config.json"
SUPPORTED_MCP_PROTOCOLS = {"2025-11-25", "2025-06-18", "2025-03-26"}
MAX_MCP_RESPONSE_BYTES = 10 * 1024 * 1024
CREWAI_EXECUTION_LOCK = threading.Lock()


def request(url, method="GET", data=None, token=None, headers=None, empty_ok=False):
    body = json.dumps(data).encode() if data is not None else None
    all_headers = {"Content-Type": "application/json", **(headers or {})}
    if token:
        all_headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, data=body, method=method, headers=all_headers)
    try:
        with urllib.request.urlopen(req, timeout=35) as response:
            raw = response.read()
            return None if not raw or empty_ok else json.loads(raw)
    except urllib.error.HTTPError as exc:
        if exc.code == 204:
            return None
        detail = exc.read().decode(errors="replace")
        raise RuntimeError(f"HTTP {exc.code}: {detail}") from exc


def api(config, path, method="GET", data=None, headers=None, empty_ok=False):
    return request(config["url"].rstrip("/") + "/api/v1" + path, method, data, config.get("worker_token"), headers, empty_ok)


def save_config(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")
    path.chmod(0o600)


def emit(config, job, message, level="info"):
    print(message, flush=True)
    try:
        api(config, f"/worker/jobs/{job['id']}/events", "POST", {"level": level, "message": message}, {"X-Lease-Token": job["lease_token"]}, True)
    except Exception as exc:
        print(f"warning: log delivery failed: {exc}", file=sys.stderr)


def builtin(job):
    kind = job["config"].get("node_kind")
    values = job.get("input_payload") or {}
    if kind != "transform":
        return values
    expression = (job["config"].get("node_config") or {}).get("expression", "$input.value")
    if expression.startswith("$input."):
        value = values
        for part in expression[7:].split("."):
            value = value[part]
        outputs = list(((job.get("config", {}).get("output_schema") or {}).get("properties") or {}))
        if len(outputs) == 1:
            return {outputs[0]: value}
        if outputs and isinstance(value, dict):
            return {name: value[name] for name in outputs if name in value}
        return {"result": value}
    raise RuntimeError("Transform currently supports expressions starting with $input.")


def run_process(config, job):
    agent = job["config"].get("draft_config") or {}
    code = agent.get("code") or ""
    language = agent.get("language") or "python"
    if not code.strip():
        outputs = list(((job.get("config", {}).get("output_schema") or {}).get("properties") or {}))
        if not outputs:
            emit(config, job, "Agent nemá kód ani výstupné porty; krok vykonávam ako no-op", "debug")
            return {}
        values = job.get("input_payload") or {}
        if all(name in values for name in outputs):
            emit(config, job, "Agent nemá kód; rovnomenné vstupy automaticky odovzdávam na výstup", "debug")
            return {name: values[name] for name in outputs}
        raise RuntimeError("Agent nemá kód a jeho pomenované výstupy nemožno vytvoriť zo vstupov: " + ", ".join(outputs))
    suffixes = {"python": ".py", "bash": ".sh", "node": ".js"}
    commands = {"python": [sys.executable], "bash": ["bash"], "node": ["node"]}
    if language not in commands:
        raise RuntimeError(f"Unsupported process language: {language}")
    with tempfile.TemporaryDirectory(prefix="agent-forge-") as directory:
        work = Path(directory)
        input_path, output_path = work / "input.json", work / "output.json"
        script_path = work / ("agent" + suffixes[language])
        input_path.write_text(json.dumps(job.get("input_payload") or {}, ensure_ascii=False))
        script_path.write_text(code)
        env = {**os.environ, "AF_INPUT_PATH": str(input_path), "AF_OUTPUT_PATH": str(output_path), "AF_JOB_ID": job["id"]}
        command = commands[language] + [str(script_path)]
        emit(config, job, "Spúšťam proces: " + " ".join(shlex.quote(part) for part in command))
        try:
            process = subprocess.run(command, cwd=work, env=env, capture_output=True, timeout=int(agent.get("timeout_seconds", 300)))
        except subprocess.TimeoutExpired as exc:
            raise RuntimeError("Process timeout exceeded") from exc
        stdout = process.stdout.decode("utf-8", errors="replace")
        stderr = process.stderr.decode("utf-8", errors="replace")
        for line in stdout.splitlines():
            emit(config, job, "stdout | " + line[:9990])
        for line in stderr.splitlines():
            emit(config, job, "stderr | " + line[:9990], "warning")
        if process.returncode:
            raise RuntimeError(f"Process exited with code {process.returncode}")
        if output_path.exists():
            emit(config, job, "Výstup načítaný zo súboru AF_OUTPUT_PATH", "debug")
            result = json.loads(output_path.read_text())
        else:
            result = output_from_stdout(config, job, stdout)
        if not isinstance(result, dict):
            raise RuntimeError("output.json must contain a JSON object")
        return result


def output_from_stdout(config, job, stdout):
    text = stdout.strip()
    if not text:
        raise RuntimeError("Proces nevytvoril AF_OUTPUT_PATH ani nevypísal žiadny stdout")
    parsed = None
    try:
        parsed = json.loads(text)
    except json.JSONDecodeError:
        last_line = next((line.strip() for line in reversed(text.splitlines()) if line.strip()), "")
        try:
            parsed = json.loads(last_line)
        except json.JSONDecodeError:
            parsed = None
    properties = (job.get("config", {}).get("output_schema") or {}).get("properties") or {}
    names = list(properties)
    if isinstance(parsed, dict):
        if names and all(name in parsed for name in names):
            result = {name: parsed[name] for name in names}
        elif len(names) == 1:
            result = {names[0]: parsed}
        else:
            result = parsed
        emit(config, job, "AF_OUTPUT_PATH nebol vytvorený; používam pomenovaný JSON objekt zo stdout", "debug")
        return result
    if len(names) > 1:
        raise RuntimeError("Proces má viac výstupných portov. Vypíš JSON objekt na stdout alebo ho zapíš do AF_OUTPUT_PATH: " + ", ".join(names))
    name = names[0] if names else "object"
    value = parsed if parsed is not None else text
    property_schema = properties.get(name) or {}
    declared_type = property_schema.get("x-agentforge-type") or property_schema.get("type") or "any"
    if declared_type in {"json", "object", "array"} and not isinstance(value, (dict, list)):
        value = {"object": value}
    elif declared_type == "string" and not isinstance(value, str):
        value = json.dumps(value, ensure_ascii=False)
    emit(config, job, f"AF_OUTPUT_PATH nebol vytvorený; stdout automaticky mapujem do výstupu '{name}'", "debug")
    return {name: value}


def run_podman(config, job):
    agent = job["config"].get("draft_config") or {}
    image = agent.get("image")
    if not image:
        raise RuntimeError("Custom image is missing")
    with tempfile.TemporaryDirectory(prefix="agent-forge-") as directory:
        work = Path(directory)
        (work / "input.json").write_text(json.dumps(job.get("input_payload") or {}, ensure_ascii=False))
        command = ["podman", "run", "--rm", "--network=none", "-v", f"{work}:/workspace:Z", "-e", "AF_INPUT_PATH=/workspace/input.json", "-e", "AF_OUTPUT_PATH=/workspace/output.json", image]
        emit(config, job, f"Spúšťam OCI image {image}")
        result = subprocess.run(command, capture_output=True, text=True, timeout=int(agent.get("timeout_seconds", 300)))
        for line in (result.stdout + result.stderr).splitlines():
            emit(config, job, line[:10000])
        if result.returncode:
            raise RuntimeError(f"Podman exited with code {result.returncode}")
        output = work / "output.json"
        if not output.exists():
            raise RuntimeError("Container did not create /workspace/output.json")
        return json.loads(output.read_text())


def run_ai(config, job):
    provider = job["config"]["provider"]
    prompt = job["config"].get("purpose") or "Process the input."
    output_properties = (job["config"].get("output_schema") or {}).get("properties") or {"result": {"type": "string"}}
    output_names = list(output_properties)
    prompt += " Return only a valid JSON object with exactly these output keys: " + ", ".join(output_names) + "."
    user_input = json.dumps(job.get("input_payload") or {}, ensure_ascii=False)
    headers = {"Content-Type": "application/json"}
    if provider.get("api_key"):
        headers["Authorization"] = "Bearer " + provider["api_key"]
    base = provider["base_url"].rstrip("/")
    provider_url = urllib.parse.urlparse(base)
    forge_url = urllib.parse.urlparse(config["url"])
    if provider_url.hostname == "host.containers.internal" and forge_url.hostname in {"127.0.0.1", "localhost", "::1"}:
        netloc = "127.0.0.1" + (f":{provider_url.port}" if provider_url.port else "")
        base = urllib.parse.urlunparse(provider_url._replace(netloc=netloc))
    if provider["kind"] == "ollama":
        emit(config, job, f"Volám Ollama model {provider['model']}")
        payload = {"model": provider["model"], "stream": False, "format": "json", "messages": [{"role": "system", "content": prompt}, {"role": "user", "content": user_input}]}
        result = request(base + "/api/chat", "POST", payload, headers=headers)
        text = result["message"]["content"]
    else:
        emit(config, job, f"Volám OpenAI-compatible model {provider['model']}")
        endpoint = base + "/chat/completions" if base.endswith("/v1") else base + "/v1/chat/completions"
        payload = {"model": provider["model"], "messages": [{"role": "system", "content": prompt + " Return only valid JSON."}, {"role": "user", "content": user_input}]}
        result = request(endpoint, "POST", payload, headers=headers)
        text = result["choices"][0]["message"]["content"]
    emit(config, job, "Model vrátil odpoveď, validujem JSON výstup")
    parsed = json.loads(text)
    return parsed if isinstance(parsed, dict) else {"result": parsed}


class McpToolError(RuntimeError):
    pass


class McpContractError(RuntimeError):
    pass


def mcp_rpc_result(message, operation):
    if message.get("error"):
        error = message["error"]
        raise RuntimeError(f"{operation}: {error.get('message', 'JSON-RPC error')} ({error.get('code', 'unknown')})")
    result = message.get("result")
    if not isinstance(result, dict):
        raise RuntimeError(f"{operation}: response has no result object")
    return result


def parse_sse_response(raw, request_id):
    messages = []
    for line in raw.decode("utf-8", errors="replace").splitlines():
        if line.startswith("data:") and line[5:].strip():
            try:
                messages.append(json.loads(line[5:].strip()))
            except json.JSONDecodeError:
                continue
    message = next((item for item in messages if item.get("id") == request_id), None)
    if message is None:
        raise RuntimeError("MCP SSE stream did not contain the requested response")
    return message


def mcp_http_post(endpoint, payload, configured_headers, session_id=None, protocol_version=None, timeout=35):
    headers = {**configured_headers, "Accept": "application/json, text/event-stream", "Content-Type": "application/json"}
    if session_id:
        headers["MCP-Session-Id"] = session_id
    if protocol_version:
        headers["MCP-Protocol-Version"] = protocol_version
    req = urllib.request.Request(endpoint, data=json.dumps(payload).encode(), method="POST", headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as response:
        raw = response.read(MAX_MCP_RESPONSE_BYTES + 1)
        if len(raw) > MAX_MCP_RESPONSE_BYTES:
            raise RuntimeError("MCP response exceeds the 10 MiB safety limit")
        next_session = response.headers.get("MCP-Session-Id") or session_id
        if not raw:
            return {}, next_session
        content_type = response.headers.get("Content-Type", "").lower()
        if "text/event-stream" in content_type:
            return parse_sse_response(raw, payload.get("id", -1)), next_session
        try:
            return json.loads(raw), next_session
        except json.JSONDecodeError as exc:
            raise RuntimeError("MCP HTTP server returned invalid JSON") from exc


def normalize_mcp_output(job, result):
    if result.get("isError"):
        text = "\n".join(item.get("text", "") for item in result.get("content", []) if item.get("type") == "text")
        raise McpToolError(text or "MCP tool returned isError=true")
    structured = result.get("structuredContent")
    content = result.get("content") or []
    properties = (job.get("config", {}).get("output_schema") or {}).get("properties") or {}
    names = list(properties)
    if isinstance(structured, dict) and names and all(name in structured for name in names):
        return {name: structured[name] for name in names}
    if len(names) == 1:
        name = names[0]
        if structured is not None:
            return {name: structured}
        text_items = [item.get("text", "") for item in content if item.get("type") == "text"]
        declared = (properties.get(name) or {}).get("x-agentforge-type") or (properties.get(name) or {}).get("type")
        if declared == "string" and text_items and len(text_items) == len(content):
            return {name: "\n".join(text_items)}
        return {name: {"content": content}}
    if isinstance(structured, dict):
        return structured
    if not names:
        return {"result": structured if structured is not None else {"content": content}}
    raise McpContractError("MCP tool did not return structuredContent for named outputs: " + ", ".join(names))


def validate_mcp_object(value, schema, label):
    if not isinstance(value, dict):
        raise McpContractError(f"{label} must be a JSON object")
    required = schema.get("required") or []
    missing = [name for name in required if name not in value]
    if missing:
        raise McpContractError(f"{label} is missing required keys: " + ", ".join(missing))
    expected_types = {
        "string": lambda item: isinstance(item, str),
        "number": lambda item: isinstance(item, (int, float)) and not isinstance(item, bool),
        "integer": lambda item: isinstance(item, int) and not isinstance(item, bool),
        "boolean": lambda item: isinstance(item, bool),
        "object": lambda item: isinstance(item, dict),
        "array": lambda item: isinstance(item, list),
    }
    for name, property_schema in (schema.get("properties") or {}).items():
        if name not in value or not isinstance(property_schema, dict):
            continue
        expected = property_schema.get("type")
        check = expected_types.get(expected)
        if check and not check(value[name]):
            raise McpContractError(f"{label}.{name} must be {expected}")


def run_mcp_http(config, job, mcp):
    endpoint = mcp.get("endpoint")
    if not endpoint:
        raise RuntimeError("MCP HTTP endpoint is missing")
    timeout = int((job["config"].get("draft_config") or {}).get("timeout_seconds", 300))
    validate_mcp_object(job.get("input_payload") or {}, job["config"].get("input_schema") or {}, "MCP arguments")
    session_id = None
    init, session_id = mcp_http_post(endpoint, {
        "jsonrpc": "2.0", "id": 1, "method": "initialize",
        "params": {"protocolVersion": "2025-11-25", "capabilities": {}, "clientInfo": {"name": "agent-forge-worker", "version": VERSION}},
    }, mcp.get("headers") or {}, timeout=min(timeout, 35))
    initialized = mcp_rpc_result(init, "initialize")
    protocol = initialized.get("protocolVersion") or mcp.get("protocol_version") or "2025-11-25"
    if protocol not in SUPPORTED_MCP_PROTOCOLS:
        raise RuntimeError(f"Server negotiated unsupported MCP protocol {protocol}")
    if "tools" not in (initialized.get("capabilities") or {}):
        raise RuntimeError("MCP server did not advertise the tools capability")
    mcp_http_post(endpoint, {"jsonrpc": "2.0", "method": "notifications/initialized"}, mcp.get("headers") or {}, session_id, protocol, min(timeout, 35))
    response, _ = mcp_http_post(endpoint, {
        "jsonrpc": "2.0", "id": 2, "method": "tools/call",
        "params": {"name": mcp["tool_name"], "arguments": job.get("input_payload") or {}},
    }, mcp.get("headers") or {}, session_id, protocol, timeout)
    output = normalize_mcp_output(job, mcp_rpc_result(response, "tools/call"))
    validate_mcp_object(output, job["config"].get("output_schema") or {}, "MCP result")
    return output


def run_mcp_stdio(config, job, mcp):
    command = mcp.get("command") or []
    if not command:
        raise RuntimeError("MCP stdio command is missing")
    timeout = int((job["config"].get("draft_config") or {}).get("timeout_seconds", 300))
    env = {**os.environ, **(mcp.get("environment") or {})}
    emit(config, job, f"Spúšťam MCP stdio server {shlex.quote(command[0])} ({max(0, len(command)-1)} argumentov)")
    validate_mcp_object(job.get("input_payload") or {}, job["config"].get("input_schema") or {}, "MCP arguments")
    process = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, encoding="utf-8", errors="replace", env=env, bufsize=1)
    messages = queue.Queue()

    def read_stdout():
        for line in process.stdout:
            if len(line.encode("utf-8", errors="replace")) > MAX_MCP_RESPONSE_BYTES:
                messages.put(RuntimeError("MCP stdio response exceeds the 10 MiB safety limit"))
                continue
            try:
                messages.put(json.loads(line))
            except json.JSONDecodeError:
                messages.put(RuntimeError("MCP stdio server wrote non-JSON data to stdout"))

    def read_stderr():
        for line in process.stderr:
            emit(config, job, "mcp stderr | " + line.rstrip()[:9980], "debug")

    threading.Thread(target=read_stdout, daemon=True).start()
    threading.Thread(target=read_stderr, daemon=True).start()

    def send(payload, expect_id=None):
        process.stdin.write(json.dumps(payload, separators=(",", ":"), ensure_ascii=False) + "\n")
        process.stdin.flush()
        if expect_id is None:
            return {}
        deadline = time.monotonic() + timeout
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise RuntimeError("MCP stdio request timed out")
            try:
                message = messages.get(timeout=remaining)
            except queue.Empty as exc:
                raise RuntimeError("MCP stdio request timed out") from exc
            if isinstance(message, Exception):
                raise message
            if message.get("id") == expect_id:
                return message

    try:
        init = send({"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-11-25", "capabilities": {}, "clientInfo": {"name": "agent-forge-worker", "version": VERSION}}}, 1)
        initialized = mcp_rpc_result(init, "initialize")
        protocol = initialized.get("protocolVersion") or "2025-11-25"
        if protocol not in SUPPORTED_MCP_PROTOCOLS:
            raise RuntimeError(f"Server negotiated unsupported MCP protocol {protocol}")
        if "tools" not in (initialized.get("capabilities") or {}):
            raise RuntimeError("MCP server did not advertise the tools capability")
        send({"jsonrpc": "2.0", "method": "notifications/initialized"})
        response = send({"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": mcp["tool_name"], "arguments": job.get("input_payload") or {}}}, 2)
        output = normalize_mcp_output(job, mcp_rpc_result(response, "tools/call"))
        validate_mcp_object(output, job["config"].get("output_schema") or {}, "MCP result")
        return output
    finally:
        try:
            process.stdin.close()
        except OSError:
            pass
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            process.terminate()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                process.kill()


def run_mcp(config, job):
    mcp = job["config"].get("mcp") or {}
    emit(config, job, f"Volám MCP tool {mcp.get('server_name', '?')} / {mcp.get('tool_name', '?')}")
    try:
        if mcp.get("transport") == "streamable-http":
            return run_mcp_http(config, job, mcp)
        if mcp.get("transport") == "stdio":
            return run_mcp_stdio(config, job, mcp)
        raise RuntimeError("Unsupported MCP transport")
    except McpToolError as exc:
        raise RuntimeError("MCP_TOOL_ERROR: " + str(exc)) from exc
    except McpContractError as exc:
        raise RuntimeError("MCP_CONTRACT_ERROR: " + str(exc)) from exc
    except Exception as exc:
        raise RuntimeError("MCP_TRANSPORT_ERROR: " + str(exc)) from exc


def crewai_output_model(schema):
    try:
        from pydantic import create_model
    except ImportError as exc:
        raise RuntimeError("CrewAI executor requires the crewai-worker image") from exc
    properties = schema.get("properties") or {}
    required = set(schema.get("required") or properties)
    python_types = {
        "string": str,
        "number": float,
        "integer": int,
        "boolean": bool,
        "object": dict,
        "json": dict,
        "array": list,
        "file": str,
        "image": str,
        "any": object,
    }
    fields = {}
    for name, definition in properties.items():
        declared = (definition or {}).get("x-agentforge-type") or (definition or {}).get("type") or "any"
        fields[name] = (python_types.get(declared, object), ... if name in required else None)
    return create_model("AgentForgeCrewOutput", **fields) if fields else None


def crewai_provider_url(config, provider):
    base = provider["base_url"].rstrip("/")
    provider_url = urllib.parse.urlparse(base)
    forge_url = urllib.parse.urlparse(config["url"])
    if provider_url.hostname == "host.containers.internal" and forge_url.hostname in {"127.0.0.1", "localhost", "::1"}:
        netloc = "127.0.0.1" + (f":{provider_url.port}" if provider_url.port else "")
        base = urllib.parse.urlunparse(provider_url._replace(netloc=netloc)).rstrip("/")
    if not base.endswith("/v1"):
        base += "/v1"
    return base


def normalize_crewai_result(job, result):
    value = None
    pydantic_value = getattr(result, "pydantic", None)
    if pydantic_value is not None:
        value = pydantic_value.model_dump()
    elif isinstance(getattr(result, "json_dict", None), dict):
        value = result.json_dict
    elif callable(getattr(result, "to_dict", None)):
        value = result.to_dict()
    if not isinstance(value, dict):
        raw = str(getattr(result, "raw", result)).strip()
        try:
            value = json.loads(raw)
        except json.JSONDecodeError:
            value = raw
    properties = (job.get("config", {}).get("output_schema") or {}).get("properties") or {}
    names = list(properties)
    if isinstance(value, dict) and all(name in value for name in names):
        return {name: value[name] for name in names} if names else value
    if len(names) == 1:
        return {names[0]: value}
    if not names:
        return value if isinstance(value, dict) else {"result": value}
    raise RuntimeError("CrewAI output is missing named keys: " + ", ".join(name for name in names if not isinstance(value, dict) or name not in value))


def run_crewai(config, job):
    try:
        from crewai import Agent as CrewAgent
        from crewai import Crew, LLM, Process, Task
    except ImportError as exc:
        raise RuntimeError(
            "CrewAI executor is not installed. Use the agent-forge-crewai-worker image "
            "or install the 'crewai-worker' optional dependency."
        ) from exc

    definition = job["config"].get("draft_config") or {}
    members_config = definition.get("members") or []
    tasks_config = definition.get("tasks") or []
    provider = job["config"].get("provider") or {}
    if not members_config or not tasks_config or not provider:
        raise RuntimeError("CrewAI configuration is incomplete")

    llm = LLM(
        model=provider["model"],
        custom_openai=True,
        base_url=crewai_provider_url(config, provider),
        api_key=provider.get("api_key") or ("ollama" if provider.get("kind") == "ollama" else "not-required"),
        timeout=max(1, min(int(definition.get("timeout_seconds", 900)), 3600)),
    )
    members = {}
    for member in members_config:
        role = member["role"]
        members[role] = CrewAgent(
            role=role,
            goal=member["goal"],
            backstory=member["backstory"],
            llm=llm,
            allow_delegation=bool(member.get("allow_delegation", False)),
            max_iter=max(1, min(int(member.get("max_iter", 20)), 100)),
            verbose=False,
        )

    output_model = crewai_output_model(job["config"].get("output_schema") or {})
    tasks = []
    for index, item in enumerate(tasks_config):
        task_name = item["name"]

        def completed(task_output, name=task_name):
            emit(config, job, f"CrewAI task dokončený: {name}")

        task_options = {
            "description": item["description"],
            "expected_output": item["expected_output"],
            "agent": members[item["agent_role"]],
            "callback": completed,
        }
        if index == len(tasks_config) - 1 and output_model is not None:
            task_options["output_pydantic"] = output_model
        tasks.append(Task(**task_options))

    process_name = definition.get("process", "sequential")
    crew_options = {
        "agents": list(members.values()),
        "tasks": tasks,
        "process": Process.hierarchical if process_name == "hierarchical" else Process.sequential,
        "memory": False,
        "cache": False,
        "share_crew": False,
        "verbose": False,
    }
    if process_name == "hierarchical":
        crew_options["manager_llm"] = llm

    emit(config, job, f"CrewAI tím štartuje: {len(members)} členov, {len(tasks)} úloh, proces {process_name}")
    # CrewAI does not expose a concurrency contract for arbitrary custom agents.
    # One crew per worker process avoids shared-library state leaking between jobs;
    # LangGraph still runs independent nodes on other workers in parallel.
    with CREWAI_EXECUTION_LOCK:
        result = Crew(**crew_options).kickoff(inputs=job.get("input_payload") or {})
    emit(config, job, "CrewAI tím dokončil všetky úlohy; validujem pomenovaný výstup")
    return normalize_crewai_result(job, result)


def execute(config, job):
    if job["executor"] == "builtin":
        return builtin(job)
    if job["executor"] == "process":
        return run_process(config, job)
    if job["executor"] == "podman":
        return run_podman(config, job)
    if job["executor"] == "managed-ai":
        return run_ai(config, job)
    if job["executor"] == "mcp":
        return run_mcp(config, job)
    if job["executor"] == "crewai":
        return run_crewai(config, job)
    raise RuntimeError("Unsupported executor: " + job["executor"])


def keep_lease(config, job, stop):
    while not stop.wait(25):
        emit(config, job, "Úloha stále beží", "debug")


def register(args):
    path = Path(args.config).expanduser()
    executors = [item.strip() for item in args.executors.split(",") if item.strip()]
    data = request(args.url.rstrip("/") + "/api/v1/worker/register", "POST", {
        "registration_token": args.token, "name": args.name or platform.node(), "worker_class": args.worker_class, "executors": executors,
        "labels": {}, "version": VERSION, "platform": platform.system().lower(), "architecture": platform.machine(),
    })
    config = {"url": args.url.rstrip("/"), "worker_id": data["worker_id"], "worker_token": data["worker_token"], "worker_class": args.worker_class, "executors": executors}
    save_config(path, config)
    print(f"Worker registered. Configuration saved to {path}")


def run_job(config, job):
    emit(config, job, f"Prevzatá úloha {job['id']} ({job['executor']})")
    lease_stop = threading.Event()
    lease_thread = threading.Thread(target=keep_lease, args=(config, job, lease_stop), daemon=True)
    lease_thread.start()
    try:
        output = execute(config, job)
        api(config, f"/worker/jobs/{job['id']}/complete", "POST", {"lease_token": job["lease_token"], "success": True, "output_payload": output, "error": ""}, empty_ok=True)
    except Exception as exc:
        emit(config, job, str(exc), "error")
        try:
            api(config, f"/worker/jobs/{job['id']}/complete", "POST", {"lease_token": job["lease_token"], "success": False, "output_payload": {}, "error": str(exc)}, empty_ok=True)
        except Exception as delivery_error:
            print(f"completion delivery failed: {delivery_error}", file=sys.stderr, flush=True)
    finally:
        lease_stop.set()
        lease_thread.join(timeout=1)


def run(args):
    path = Path(args.config).expanduser()
    config = json.loads(path.read_text())
    print(f"Agent Forge Worker {VERSION}; class={config.get('worker_class', 'universal')}; concurrency={args.concurrency}; executors={','.join(config['executors'])}")
    last_heartbeat = 0.0
    active = set()
    while True:
        try:
            active = {thread for thread in active if thread.is_alive()}
            if time.monotonic() - last_heartbeat > 15:
                api(config, "/worker/heartbeat", "POST", {"executors": config["executors"], "version": VERSION}, empty_ok=True)
                last_heartbeat = time.monotonic()
            if len(active) >= args.concurrency:
                time.sleep(min(args.poll_interval, 0.5))
                continue
            job = api(config, "/worker/jobs/claim", "POST", {})
            if not job:
                time.sleep(args.poll_interval)
                continue
            thread = threading.Thread(target=run_job, args=(config, job), daemon=True)
            active.add(thread)
            thread.start()
        except KeyboardInterrupt:
            if active:
                print("Worker sa zastavuje; čakám na aktívne úlohy", file=sys.stderr, flush=True)
                for thread in active:
                    thread.join()
            return
        except Exception as exc:
            print(f"connection error: {exc}", file=sys.stderr, flush=True)
            time.sleep(min(args.poll_interval * 2, 15))


def main():
    parser = argparse.ArgumentParser(prog="agent-forge-worker")
    parser.add_argument("--config", default=str(DEFAULT_CONFIG))
    commands = parser.add_subparsers(dest="command", required=True)
    reg = commands.add_parser("register")
    reg.add_argument("--url", required=True)
    reg.add_argument("--token", required=True)
    reg.add_argument("--name")
    reg.add_argument("--class", dest="worker_class", choices=("cpu", "gpu", "universal"), default="universal")
    reg.add_argument("--executors", default="process,builtin")
    start = commands.add_parser("run")
    start.add_argument("--poll-interval", type=float, default=2.0)
    start.add_argument("--concurrency", type=int, choices=range(1, 65), default=2, metavar="1..64")
    args = parser.parse_args()
    register(args) if args.command == "register" else run(args)


if __name__ == "__main__":
    main()
